{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horarioxata",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "HORARIOS",
      "id": "125ba4b173554cbfa540e1364c0b855f"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
